{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{apps,lib,config.js,server.js}/**",
      "maxDuration": 60,
      "memory": 2048,
      "excludeFiles": "**/apps/files/assets/hls/**/*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "installCommand": "cd .. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
  "framework": null,
  "buildCommand": "node -e \"require('fs').mkdirSync('public',{recursive:true})\"",
  "outputDirectory": "public"
}
