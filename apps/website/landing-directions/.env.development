# Local mock backend (mock/, started by `pnpm dev` at the root).
# Published content, leads and ideas come from the Website Manager API; unset, the site uses src/content/snapshot.js.
VITE_CMS_API=http://localhost:4007/v2
VITE_WM_ORIGIN=http://localhost:3007
# Pricing, checkout and account calls still go to the mock's suite API (the SaaS side, not part of this project).
VITE_SUITE_API=http://localhost:4000/api
