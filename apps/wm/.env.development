# Local mock backend (mock/, started by `pnpm dev` at the root). These match the defaults in lib/env.ts.
NEXT_PUBLIC_WM_API_URL=http://localhost:4007
NEXT_PUBLIC_SOS_API_URL=http://localhost:4000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:4173
# No SOS frontend in this project: "home" and sign-out land back on the Website Manager.
NEXT_PUBLIC_SOS_URL=http://localhost:3007
# The shared password of the mock test accounts (mock/lib/identity.js), used by /sign-in. Local only.
NEXT_PUBLIC_LOCAL_PASSWORD=Local@2026
